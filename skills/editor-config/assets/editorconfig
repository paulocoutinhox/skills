root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,vue,svelte}]
indent_size = 2

[*.{html,htm,css,scss,sass,less,svg,xml,yml,yaml}]
indent_size = 2

[*.{py,pyi,swift,kt,kts,java,cs,c,h,cc,hh,cpp,hpp,cxx,hxx,rs,dart,php}]
indent_size = 4

[*.{rb,rake,gemspec,sh,bash,zsh}]
indent_size = 2

[{Gemfile,Rakefile}]
indent_size = 2

[*.{md,mdx,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[{Makefile,GNUmakefile,makefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 8

[*.{bat,cmd}]
end_of_line = crlf
