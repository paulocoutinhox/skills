root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,html,xml,plist,css,scss,svg,js,jsx,ts,tsx,vue}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab

[*.go]
indent_style = tab
